    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Gallery Navigation
            const images = [
                {% for img in property.images %}"{{ img }}"{% if not loop.last %},{% endif %}{% endfor %}
            ];
            let currentIndex = 0;
            const mainImg = document.getElementById('propertyMainImg');
            const thumbs = document.querySelectorAll('.property-thumb');
            
            window.changePropertyImage = function(index) {
                currentIndex = index;
                mainImg.src = "/" + images[currentIndex];
                thumbs.forEach((t, idx) => {
                    if (idx === currentIndex) {
                        t.classList.add('active');
                        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                    } else {
                        t.classList.remove('active');
                    }
                });
            };
            
            const nextBtn = document.getElementById('propertyNext');
            const prevBtn = document.getElementById('propertyPrev');
            
            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    if(images.length > 0) {
                        window.changePropertyImage((currentIndex + 1) % images.length);
                    }
                });
            }
            
            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    if(images.length > 0) {
                        window.changePropertyImage((currentIndex - 1 + images.length) % images.length);
                    }
                });
            }

            // Mobile menu
            const menuToggle = document.getElementById('menuToggle');
            const mobileMenu = document.getElementById('mobileMenu');
            const closeBtn = document.getElementById('closeBtn');
            
            if (menuToggle) menuToggle.addEventListener('click', () => mobileMenu.classList.add('active'));
            if (closeBtn) closeBtn.addEventListener('click', () => mobileMenu.classList.remove('active'));

            // Initialize Flatpickr and Form Handlers
            if (typeof flatpickr !== 'undefined') {
                const checkOutFp = flatpickr("#propertyCheckout", { minDate: "today", disableMobile: true });
                flatpickr("#propertyCheckin", {
                    minDate: "today",
                    disableMobile: true,
                    onChange: function(selectedDates, dateStr, instance) {
                        if (checkOutFp && selectedDates.length > 0) {
                            const nextDay = new Date(selectedDates[0]);
                            nextDay.setDate(nextDay.getDate() + 1);
                            checkOutFp.set('minDate', nextDay);
                        }
                    }
                });
            }

            const form = document.getElementById('propertyContactForm');
            const btnEmail = document.getElementById('btnPropertyEmail');
            const btnWhatsapp = document.getElementById('btnPropertyWhatsapp');
            const status = document.getElementById('propertyFormStatus');

            if (btnEmail) {
                btnEmail.addEventListener('click', async function() {
                    if (!form.reportValidity()) return;
                    const data = Object.fromEntries(new FormData(form).entries());
                    data.message = `Property: ${data.property_name}\nDates: ${data.checkin} to ${data.checkout}\nGuests: ${data.guests}`;
                    
                    btnEmail.disabled = true;
                    btnEmail.innerHTML = 'Sending...';
                    status.style.color = 'var(--text-gray)';
                    status.innerText = '';
                    
                    try {
                        const res = await fetch('/api/contact', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        
                        if (res.ok) {
                            status.style.color = 'green';
                            status.innerText = 'Sent successfully!';
                            form.reset();
                        } else {
                            throw new Error('Server error');
                        }
                    } catch (e) {
                        status.style.color = 'red';
                        status.innerText = 'Unable to send email right now. Please try WhatsApp.';
                    } finally {
                        btnEmail.disabled = false;
                        btnEmail.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg> Submit Enquiry`;
                    }
                });
            }

            if (btnWhatsapp) {
                btnWhatsapp.addEventListener('click', function() {
                    if (!form.reportValidity()) return;
                    const data = Object.fromEntries(new FormData(form).entries());
                    const text = `Hi, I am interested in booking *${data.property_name}*.\nName: ${data.name}\nContact: ${data.email}\nDates: ${data.checkin} to ${data.checkout}\nGuests: ${data.guests}`;
                    window.open(`https://wa.me/447879991235?text=${encodeURIComponent(text)}`, '_blank');
                });
            }
        });
    </script>
</body>
</html>
